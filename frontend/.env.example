# Configuración del frontend (opcional). No hay secretos aquí: el frontend nunca recibe credenciales
# de Databricks ni de Azure OpenAI; solo habla con el backend (carpeta ../backend).

# Desarrollo: a dónde redirige Vite las peticiones /api. Por defecto, el backend local:
# VITE_BACKEND_URL=http://localhost:8787
# Para usar el backend desplegado como Databricks App («backendoficial»); el proxy de Vite le añade
# un token OAuth sacado de `databricks auth token -p <perfil>` (inicia sesión con `databricks auth login`):
# VITE_BACKEND_URL=https://backendoficial-7405605482140954.14.azure.databricksapps.com
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# Producción con frontend y backend en orígenes distintos: URL pública del backend.
# Si se sirve el build desde el propio backend (npm run build:backend), déjalo vacío.
# VITE_API_BASE=https://mi-backend.example.com
