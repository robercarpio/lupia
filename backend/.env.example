# Backend · variables de entorno para desarrollo local.
# Copia este fichero a .env (está en .gitignore) y rellena los valores. En Databricks Apps se definen en app.yaml.
# Nunca escribas aquí secretos reales en el .example ni los subas al repositorio.

# ── Databricks ────────────────────────────────────────────────────────
# Workspace (Azure Databricks). Si usas un perfil de `databricks auth login`, puedes dejarlo vacío.
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
# SQL Warehouse: Compute → SQL Warehouses → el warehouse → Connection details → HTTP path.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# Token personal (opcional). Sin token, se usa el perfil OAuth de ~/.databrickscfg (databricks auth login)
# o el Service Principal en Databricks Apps. No se registra en logs ni se envía nunca al navegador.
DATABRICKS_TOKEN=
# Capa Gold que consume el backend (catálogo y esquema).
DATABRICKS_CATALOG=dat_hack_rb06
DATABRICKS_SCHEMA=rbe
# Perfil de ~/.databrickscfg a usar cuando no hay token (por defecto, DEFAULT).
# DATABRICKS_CONFIG_PROFILE=DEFAULT

# Equivalentes antiguos (siguen funcionando): DATABRICKS_WAREHOUSE_ID=<id>  y  RBE_SCHEMA=catalogo.esquema

# ── Copiloto (Azure OpenAI) ───────────────────────────────────────────
# Sin estas variables el chat y la voz responden en «modo básico» (determinista, solo con datos).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Opcionales ────────────────────────────────────────────────────────
# CACHE_TTL_SECONDS=900              # caché de consultas de ventas (los datos de ventas cambian poco)
# CACHE_STALE_SECONDS=21600          # pasado el TTL, se sirve el último dato y se refresca en segundo plano
# WARM_UP_ON_START=1                 # precalentar conexiones y dashboard por defecto al arrancar
# ANOMALY_REFRESH_SECONDS=60         # cada cuánto se mira si el modelo ha escrito anomalías nuevas
# SQL_STATEMENT_TIMEOUT_SECONDS=120  # tiempo máximo de una consulta en el warehouse
# SQL_POOL_SIZE=4
# RBE_PCT_UNITS=percent              # columnas *_pct en puntos porcentuales (-45.20); "fraction" si son -0.452
# CORS_ORIGINS=*                     # orígenes permitidos si el frontend se sirve desde otro dominio
# FRONTEND_DIST=static               # build de Vite servido por el backend (npm run build:backend)
